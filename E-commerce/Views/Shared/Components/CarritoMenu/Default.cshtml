@model List<E_commerce.Models.CarritoDetalle>
@{
    var ar = new System.Globalization.CultureInfo("es-AR");
    var cantidad = Model.Sum(d => d.Cantidad);
    var total = Model.Sum(d => d.Cantidad * d.Producto.Precio);
}

<div class="dropdown me-3">
    <button class="btn btn-outline-dark position-relative"
            type="button"
            data-bs-toggle="dropdown">
        🛒
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            @cantidad
        </span>
    </button>

    <div class="dropdown-menu dropdown-menu-end p-0" style="width:350px;">

        <div class="p-3 border-bottom"><strong>Carrito</strong></div>

        <div style="max-height:300px; overflow-y:auto;">
            @if (!Model.Any())
            {
                <div class="p-3 text-center text-muted">No hay productos en el carrito</div>
            }
            else
            {
                @foreach (var d in Model)
                {
                    <div class="d-flex justify-content-between p-2 border-bottom small">
                        <span>@d.Cantidad × @d.Producto.Nombre</span>
                        <span>@((d.Cantidad * d.Producto.Precio).ToString("C2", ar))</span>
                    </div>
                }
            }
        </div>

        <div class="p-3 border-top">
            @if (Model.Any())
            {
                <div class="d-flex justify-content-between mb-2">
                    <strong>Total</strong>
                    <strong>@total.ToString("C2", ar)</strong>
                </div>
            }
            <a asp-controller="Carrito" asp-action="Index" class="btn btn-primary w-100">Ver carrito</a>
        </div>
    </div>
</div>