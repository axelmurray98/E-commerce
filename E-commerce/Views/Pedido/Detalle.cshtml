@model E_commerce.Models.Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.PedidoId}";
    var ar = new System.Globalization.CultureInfo("es-AR");
    var detalles = (List<E_commerce.Models.PedidoDetalle>)ViewBag.Detalles;
}

@if (TempData["Ok"] != null)
{
    <div id="toastAviso"
         class="alert alert-success shadow position-fixed top-0 start-50 translate-middle-x mt-3"
         style="z-index:2000; min-width:300px; transition: opacity .4s;">
        @TempData["Ok"]
    </div>
}

<div class="container mt-4">
    <h2>Pedido #@Model.PedidoId</h2>
    <p class="text-muted">
        Envío a: @Model.Calle @Model.Numero, @Model.Ciudad, @Model.Provincia (@Model.CodigoPostal)
    </p>

    <table class="table align-middle">
        <thead class="table-dark">
            <tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th></tr>
        </thead>
        <tbody>
            @foreach (var d in detalles)
            {
                <tr>
                    <td>@d.NombreProducto</td>
                    <td>@d.PrecioUnitario.ToString("C2", ar)</td>
                    <td>@d.Cantidad</td>
                    <td>@d.Subtotal.ToString("C2", ar)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th class="text-success fs-5">@Model.Total.ToString("C2", ar)</th>
            </tr>
        </tfoot>
    </table>

    <a asp-action="MisPedidos" class="btn btn-outline-primary">Volver a mis pedidos</a>
</div>

@section Scripts {
    <script>
        const aviso = document.getElementById('toastAviso');
        if (aviso) {
            setTimeout(function () {
                aviso.style.opacity = '0';
                setTimeout(function () { aviso.remove(); }, 400);
            }, 2000);
        }
    </script>
}
