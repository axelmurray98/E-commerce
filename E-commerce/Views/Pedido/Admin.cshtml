@model List<E_commerce.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
    var ar = new System.Globalization.CultureInfo("es-AR");

    int pagina = ViewBag.Pagina ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Todos los pedidos</h2>

        @if (totalPaginas > 1)
        {
            <nav>
                <ul class="pagination mb-0">

                    <li class="page-item @(pagina == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Admin"
                           asp-route-pagina="@(pagina - 1)">
                            Anterior
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == pagina ? "active" : "")">
                            <a class="page-link"
                               asp-action="Admin"
                               asp-route-pagina="@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(pagina == totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Admin"
                           asp-route-pagina="@(pagina + 1)">
                            Siguiente
                        </a>
                    </li>

                </ul>
            </nav>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay pedidos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>N°</th>
                        <th>Fecha</th>
                        <th>Envío a</th>
                        <th>Pago</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th width="80"></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>

                            <td>#@p.PedidoId</td>

                            <td>
                                @p.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @p.Calle @p.Numero, @p.Ciudad
                            </td>

                            <td>
                                @p.MetodoPago
                            </td>

                            <td>
                                @p.Total.ToString("C", ar)
                            </td>

                            <td style="min-width:300px">
                                <form asp-action="CambiarEstado"
                                      method="post"
                                      class="d-flex gap-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@p.PedidoId" />

                                    <input type="hidden"
                                           name="pagina"
                                           value="@pagina" />

                                    <select name="estado"
                                            class="form-select form-select-sm">

                                        @foreach (var e in Enum.GetValues<E_commerce.Models.EstadoPedido>())
                                        {
                                            if (e == p.Estado)
                                            {
                                                <option value="@e" selected>
                                                    @e
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@e">
                                                    @e
                                                </option>
                                            }
                                        }

                                    </select>

                                    <button type="submit"
                                            class="btn btn-primary btn-sm">
                                        OK
                                    </button>

                                </form>
                            </td>

                            <td>
                                <a asp-action="Detalle"
                                   asp-route-id="@p.PedidoId"
                                   class="btn btn-info btn-sm">
                                    Ver
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
</div>