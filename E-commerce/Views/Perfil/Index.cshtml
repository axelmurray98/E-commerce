@model E_commerce.Models.PerfilVm
@{
    ViewData["Title"] = "Mi perfil";
}

@if (TempData["Ok"] != null)
{
    <div id="toastAviso"
         class="alert alert-success shadow position-fixed top-0 start-50 translate-middle-x mt-3"
         style="z-index:2000; min-width:300px; transition: opacity .4s;"
         role="alert">
        @TempData["Ok"]
    </div>
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0">Mi perfil</h3>
                </div>

                <div class="card-body">
                    <form asp-action="Index" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>
                            <input asp-for="Email" class="form-control" disabled />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellido" class="form-label"></label>
                                <input asp-for="Apellido" class="form-control" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>
                        </div>

                        <p class="text-muted small">
                            Miembro desde @Model.FechaRegistro.ToString("dd/MM/yyyy")
                        </p>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const aviso = document.getElementById('toastAviso');
        if (aviso) {
            setTimeout(function () {
                aviso.style.opacity = '0';
                setTimeout(function () { aviso.remove(); }, 400);
            }, 2000);
        }
    </script>
}