using E_commerce.Data;
using E_commerce.Models;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Microsoft.AspNetCore.Mvc.Rendering;

namespace E_commerce.Controllers
{
    public class AppUsuarioController : Controller
    {
     
        private readonly UserManager<AppUsuario> _userManager;
        private readonly RoleManager<IdentityRole> _roleManager;
        private readonly AppDbContext _context;

        public AppUsuarioController(UserManager<AppUsuario> userManager,RoleManager<IdentityRole> roleManager,AppDbContext context)
        {
            
            _userManager = userManager;
            _roleManager = roleManager;
            _context = context;
        }

        // GET: AppUsuario
        public async Task<IActionResult> Index()
        {
            var adminEmail = "admin@admin.com";
            var adminRoleId = await _context.Roles
                .Where(r => r.Name == "Admin")
                .Select(r => r.Id).SingleOrDefaultAsync();

            var usuarios = await _context.Users
                .Where(u => u.Email != adminEmail)
                .Select(u => new UsuarioVm
                {
                    Id = u.Id,
                    Nombre = u.Nombre,
                    Apellido = u.Apellido,
                    Email = u.Email,
                    IsAdmin = _context.UserRoles.Any(ur => ur.UserId == u.Id &&
                    _context.Roles.Any(r => ur.RoleId && r.Name == "Admin")),
                    

                });
            return View(await _userManager.Users.ToListAsync());
        }

      
    }
}
